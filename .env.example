# --- Telegram Bot API bot (the poster) ---
BOT_TOKEN=
# Your private draft group/chat id where the bot receives forwards and sends approval cards.
# (Forward any message to @userinfobot to get a chat id.)
DRAFT_CHAT_ID=
# Your public deals channel (bot must be admin here). Use @channelusername or -100... id.
DEALS_CHANNEL=

# --- Telethon reader (your account, watches source channels) ---
# Get free credentials at https://my.telegram.org
TG_API_ID=
TG_API_HASH=
# Phone number of your Telegram account, e.g. +919876543210
TG_PHONE=
# Source channels to watch (usernames or invite links, comma-separated)
SOURCE_CHANNELS=@channel1,@channel2
# Where the reader forwards matched loots (same private group as DRAFT_CHAT_ID)
READER_TARGET_CHAT=

# --- Affiliate link conversion (pick one) ---
AFFILIATE_PROVIDER=cuelinks        # cuelinks | earnkaro | none
CUELINKS_API_KEY=
EARNKARO_API_KEY=

# --- Render webhook bot (alternative to 24/7 bot.py) ---
# Your public Render URL, e.g. https://deals-bot.onrender.com (set after deploy)
WEBHOOK_URL=

# --- Render cron reader (alternative to 24/7 reader.py) ---
# Base64 session from login.py (Render can't hold binary secret files)
READER_SESSION_B64=
# Minutes to look back on first run / after a fresh deploy
CRON_LOOKBACK_MINUTES=20
MAX_FORWARDS_PER_RUN=10

# --- AI post enhancement (optional, fail-open) ---
# Provider order: zai -> groq. Pin one with AI_PROVIDER=zai / groq.
AI_PROVIDER=auto
ZAI_API_KEY=
ZAI_MODEL=
GROQ_API_KEY=
# Model override (default llama-3.1-8b-instant); e.g. llama-3.3-70b-versatile
GROQ_MODEL=

# --- Loot detection tuning ---
# Minimum discount % to treat a post as a loot candidate
MIN_DISCOUNT_PCT=70
# Extra keywords that always qualify a post (comma-separated)
LOOT_KEYWORDS=loot,price error,priceerror,glitch,steal deal,price drop,loot deal
